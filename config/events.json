def validate_events(events: List[SentimentEvent]) -> None:
    errors = []
    for e in events:
        if not e.evidence_anchor or len(e.evidence_anchor.strip()) < 8:
            errors.append(f"{e.event_id}: evidence_anchor 过短或为空")
        for nid in e.node_ids:
            if nid not in NODE_REGISTRY:
                errors.append(f"{e.event_id}: 未知节点 {nid}")
        if not (0.0 <= e.severity_raw <= 1.0):
            errors.append(f"{e.event_id}: severity_raw 越界 {e.severity_raw}")
    if errors:
        raise ValueError("\n".join(errors))

    covered = {n for e in events for n in e.node_ids}
    print(f"校验通过：{len(events)} 条事件，覆盖 {len(covered)}/13 个节点。")
    print(f"未覆盖节点：{sorted(set(NODE_REGISTRY) - covered)}")
    for e in events:
        if e.mapping_note:
            print(f"[代理] {e.event_id} -> {e.node_ids}")


if __name__ == "__main__":
    validate_events(EVENTS)
